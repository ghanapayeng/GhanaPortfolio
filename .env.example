# ==============================================================================
# GHANA KANTA PAYENG PORTFOLIO - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and replace the values with your actual credentials:
#   cp .env.example .env
# ==============================================================================

# Backend Server Port
PORT=8080

# ------------------------------------------------------------------------------
# MYSQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ghana_portfolio
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# ------------------------------------------------------------------------------
# DIRECT EMAIL NOTIFICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Destination email where inquiries from "Connect With Me" form are sent:
NOTIFICATION_EMAIL=ghanakanta076@gmail.com

# Gmail SMTP Server Credentials
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=ghanakanta076@gmail.com
# Google 16-character App Password (generate at https://myaccount.google.com/apppasswords)
MAIL_PASSWORD=your_google_app_password_here

# ------------------------------------------------------------------------------
# FRONTEND API CONFIGURATION
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1
